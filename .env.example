# Development (.env.local) — production uses panel.env + POSTGRES_PASSWORD
PORT=3400
DATABASE_URL=postgres://asterisk_panel:CHANGE_ME@127.0.0.1:5432/asterisk_panel
APP_SECRET=generate-with-openssl-rand-hex-32
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-login
# Time zone of the PBX (clock, "today" in reports and dashboard)
TZ=Asia/Tehran
